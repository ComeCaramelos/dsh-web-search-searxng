# Line endings
#
# Both halves of this plugin are read as source — Node for the host half, the
# browser bundle for the client half — and `.editorconfig` already pins
# `end_of_line = lf`. Nothing here is meant to be platform-dependent: every
# tracked file is stored *and* checked out as LF, so the working tree stays
# byte-stable regardless of who clones it, and a stray CRLF cannot silently
# reappear through a checkout.
* text=auto eol=lf

# Sources and metadata: stated explicitly on top of the blanket rule, so a file
# added later can never be classified by content sniffing alone.
*.ts   text eol=lf
*.d.ts text eol=lf
*.css  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Git hooks must stay LF on every platform: a CRLF shebang is not executable,
# and a trailing CR taints shell assignments (e.g. `version=...`).
.githooks/* text eol=lf

# Repository metadata.
.gitattributes text eol=lf
.editorconfig  text eol=lf
.gitignore     text eol=lf
